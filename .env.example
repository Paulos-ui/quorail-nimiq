# Optional public, CORS-enabled RPC endpoints. Never place secrets here.
NEXT_PUBLIC_NIMIQ_MAINNET_RPC=https://rpc.nimiqwatch.com
NEXT_PUBLIC_NIMIQ_TESTNET_RPC=https://rpc.testnet.nimiqwatch.com/

# V3 optional AI. SERVER ONLY. Never use NEXT_PUBLIC_ for these secrets.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global limit across all clients, plus 20 requests/client/hour.
AI_DAILY_REQUEST_LIMIT=100

# Vercel Marketplace aliases KV_REST_API_URL and KV_REST_API_TOKEN
# are also accepted as a complete pair. Use the read/write REST token.
